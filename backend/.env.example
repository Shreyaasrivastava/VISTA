# Copy to .env and fill in. Never commit .env.
# At least 16 characters, random. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_MINUTES=60
# Local dev default is SQLite. docker-compose.yml overrides this with Postgres.
DATABASE_URL=sqlite:///./vista.db
# Comma separated origins allowed to call the API from a browser (the web UI).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Used by docker-compose for the Postgres container.
POSTGRES_PASSWORD=
